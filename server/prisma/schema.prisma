generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "sqlite"
  url        = env("DATABASE_URL")
  
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   // STUDENT, INDUSTRY, ACADEMICIAN, INSTITUTION, ADMIN
  name      String
  phone     String?
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile     StudentProfile?
  industryProfile    IndustryProfile?
  academicianProfile AcademicianProfile?
  institutionProfile InstitutionProfile?

  opportunities PostedOpportunity[]
  applications  Application[]
  notifications Notification[]
}

model StudentProfile {
  id             String  @id @default(uuid())
  user           User    @relation(fields: [userId], references: [id])
  userId         String  @unique
  specialization String?
  institution    String?
  enrollmentYear Int?
  bio            String?
  resumeUrl      String?
  skills         String? // Storing as comma-separated or JSON string
  embedding      String?

  assessmentResults AssessmentResult[]
  attempts          AssessmentAttempt[]
  certificates      Certificate[]
  projects          Project[]
  mentorFeedbacks   MentorFeedback[]
}

model IndustryProfile {
  id          String  @id @default(uuid())
  user        User    @relation(fields: [userId], references: [id])
  userId      String  @unique
  companyName String
  industry    String?
  website     String?
  description String?
  location    String?
  logo        String?
}

model AcademicianProfile {
  id          String  @id @default(uuid())
  user        User    @relation(fields: [userId], references: [id])
  userId      String  @unique
  institution String?
  department  String?
  designation String?
  expertise   String? // Storing as JSON string
  bio         String?
}

model InstitutionProfile {
  id              String  @id @default(uuid())
  user            User    @relation(fields: [userId], references: [id])
  userId          String  @unique
  institutionName String
  type            String?
  accreditation   String?
  location        String?
  website         String?
  description     String?
}

model SkillTaxonomy {
  qpCode           String   @id
  roleName         String   @unique
  nsqfLevel        Int
  competencyUnits  String
  source           String   @default("Healthcare Sector Skill Council — AYUSH Sub-Council")
  createdAt        DateTime @default(now())

  assessments      Assessment[]
}

model Assessment {
  id             String         @id @default(uuid())
  title          String
  description    String?
  taxonomy       SkillTaxonomy? @relation(fields: [qpCode], references: [qpCode])
  qpCode         String?
  nsqfLevel      Int            @default(4) // NSQF level 1-10
  category       String?        // Skill area shown on cards / charts
  questions      String         // JSON array: [{ q, options[], correctIndex }]
  duration       Int            // minutes
  totalMarks     Int
  passingPercent Int            @default(60)
  proctored      Boolean        @default(true)
  isPractice     Boolean        @default(false) // student practice set (private to creator)
  source         String         @default("MANUAL") // MANUAL | UPLOAD | AI
  createdById    String?        // user who uploaded the question set (null = platform/seed)
  createdAt      DateTime       @default(now())

  results  AssessmentResult[]
  attempts AssessmentAttempt[]
}

// One proctored sitting of an assessment. Created on start, kept alive by heartbeats,
// closed on submit (or finalised automatically when abandoned / time expires).
model AssessmentAttempt {
  id              String         @id @default(uuid())
  assessment      Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId    String
  student         StudentProfile @relation(fields: [studentId], references: [id])
  studentId       String
  status          String         @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | ABANDONED
  startedAt       DateTime       @default(now())
  expiresAt       DateTime
  lastHeartbeatAt DateTime       @default(now())
  questionOrder   String         // JSON: original question indices in display order
  optionOrder     String         // JSON: { [questionIndex]: original option indices in display order }
  answers         String         @default("{}") // JSON autosave: { [questionIndex]: optionIndex }
  violationCount  Int            @default(0)
  events          String         @default("[]") // JSON: latest proctoring events (capped)
  lastSnapshot    String?        // small webcam thumbnail for the live monitoring dashboard
  faceCount       Int?
  resumeCount     Int            @default(0)
  environment     String?        // JSON: device / browser integrity checks at start
  resultId        String?
}

model AssessmentResult {
  id             String         @id @default(uuid())
  student        StudentProfile @relation(fields: [studentId], references: [id])
  studentId      String
  assessment     Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId   String
  score          Int
  maxScore       Int
  percentage     Int            @default(0)
  answers        String         // JSON string
  skillScores    String?        // JSON string
  // --- AI proctoring ---
  violationCount Int            @default(0)
  flagged        Boolean        @default(false)
  autoSubmitted  Boolean        @default(false)
  submitReason   String?        // MANUAL, TIME_UP, MAX_VIOLATIONS, PAGE_CLOSED
  proctoringLog  String?        // JSON: { events: [...], snapshots: [...], summary }
  timeTakenSec   Int?
  completedAt    DateTime       @default(now())
}

model PostedOpportunity {
  id              String          @id @default(uuid())
  postedBy        User            @relation(fields: [postedById], references: [id])
  postedById      String
  title           String
  description     String
  type            String          // INTERNSHIP, JOB, PROJECT, FDP, RESEARCH
  location        String?
  isRemote        Boolean         @default(false)
  requiredQpCodes String?         // JSON string
  stipend         String?
  deadline        DateTime?
  status          String          @default("OPEN")
  embedding       String?
  applications    Application[]
  createdAt       DateTime        @default(now())
}

model Application {
  id            String            @id @default(uuid())
  student       User              @relation(fields: [studentId], references: [id]) // Linking to User instead of StudentProfile to simplify query
  studentId     String
  opportunity   PostedOpportunity @relation(fields: [opportunityId], references: [id])
  opportunityId String
  status        String            @default("APPLIED") // APPLIED, SHORTLISTED, INTERVIEWED, SELECTED, REJECTED
  coverLetter   String?
  appliedAt     DateTime          @default(now())
}

model Certificate {
  id              String         @id @default(uuid())
  student         StudentProfile @relation(fields: [studentId], references: [id])
  studentId       String
  title           String
  issuer          String
  issueDate       DateTime
  verificationUrl String?
  description     String?
}

model Project {
  id           String         @id @default(uuid())
  student      StudentProfile @relation(fields: [studentId], references: [id])
  studentId    String
  title        String
  description  String?
  technologies String? // JSON string
  projectUrl   String?
  startDate    DateTime?
  endDate      DateTime?
}

model MentorFeedback {
  id        String         @id @default(uuid())
  mentorId  String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  studentId String
  rating    Int
  feedback  String?
  createdAt DateTime       @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  message   String
  type      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Badge {
  id          String   @id @default(uuid())
  studentId   String
  name        String   // e.g. "Ayurveda Starter", "Assessment Champion"
  description String
  icon        String   // emoji or icon name
  awardedAt   DateTime @default(now())
}
