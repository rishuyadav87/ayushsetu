# server/.env
NODE_ENV=development
PORT=5000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
DATABASE_URL="postgresql://ayush:ayush_secret@localhost:5432/ayush_setu"
AI_ENGINE_URL=http://localhost:8000

# AI features (optional). Set ONE provider:
#  - Gemini: free key at https://aistudio.google.com/apikey
#  - or any OpenAI-compatible API (OpenAI, Groq, OpenRouter, local Ollama) via OPENAI_BASE_URL
# Without a key: chatbot uses the built-in knowledge base and AI tests use the reviewed question bank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
